{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "DenyRolesAnywhereSessionOutsideTrustedNetwork",
      "Effect": "Deny",
      "Principal": "*",
      "Action": [
        "rolesanywhere:CreateSession"
      ],
      "Resource": "*",
      "Condition": {
        "StringNotEqualsIfExists": {
          "aws:SourceVpce": ["vpce-0123456789abcdef0"]
        }
      }
    }
  ]
}